# Dedicated Neon project for Sports Prediction Engine.
# Do not reuse the "noleggio spiaggia rosa" database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# API-Football / API-Sports. Prefer API_SPORTS_KEY (TASK 057); API_FOOTBALL_KEY accepted as alias.
# Never commit a real key. Never log the value.
API_SPORTS_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_SPORTS_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_MIN_INTERVAL_MS=7000

# football-data.org API v4. Leave empty until you have a free token.
FOOTBALL_DATA_ORG_TOKEN=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_ORG_MIN_INTERVAL_MS=7000

# ClubElo public CSV (api.clubelo.com). Optional interval; default 500ms.
CLUBELO_MIN_INTERVAL_MS=500

# The Odds API — live /odds with ISO last_update + commence_time. Leave empty until you have a key.
# Do not commit a real key. TASK 038 stays LIVE_NOT_CONFIGURED without it. Never log the value.
# Exact remaining input: THE_ODDS_API_KEY=<user must provide>
THE_ODDS_API_KEY=

INGEST_MAX_RETRIES=3
INGEST_TIMEOUT_MS=15000
INGEST_MIN_INTERVAL_MS=700

# --- BetMind / TASK 058 production ---
# Paper trading only. Never set true in this project.
REAL_MONEY=false
# Optional public URL after deploy (do not invent). Used for docs/smoke only.
# NEXT_PUBLIC_APP_URL=
# Persistent Lab B store path (default: audit/external/task-044 under cwd).
# BETMIND_STORE_ROOT=
# Scraping is always on (ordinary HTTP GET). CONTEXT only; never MODEL.
# 403 / CAPTCHA / Cloudflare challenge pages stay BLOCKED. No WAF bypass.
# BETMIND_TEST_SCRAPE is ignored (legacy name; scrape lane is permanent).
# Per-cycle event research budget (queue still holds all upcoming events).
# RESEARCH_EVENT_BUDGET=48

